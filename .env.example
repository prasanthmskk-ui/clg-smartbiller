# Frontend API URL
# Local development: leave empty to use the Vite proxy.
# Production on Vercel: set this to the deployed Render service URL.
VITE_API_URL=

# Backend local development settings
BACKEND_PORT=5000
BACKEND_HOST=127.0.0.1

# Flask backend database settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billing_db
DB_USER=billing_user
DB_PASSWORD=
DB_CONNECTION_TIMEOUT=5

# Local frontend origins, or comma-separated Vercel origin(s) in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173